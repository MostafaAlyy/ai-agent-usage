#!/usr/bin/python3
"""Print the OpenAI Codex usage record as one JSON line.

Where the numbers come from
---------------------------
The Codex CLI ships an `app-server` subcommand that speaks JSON-RPC over
stdio -- the same transport its own editor integrations use. Two calls give
us everything the panel shows:

    account/read              -> plan type, whether auth is required
    account/rateLimits/read   -> usedPercent / windowDurationMins / resetsAt

This is the mechanism Omarchy 4 uses (bin/omarchy-agent-usage-codex). It is
NOT a documented public API, so it is deliberately fenced into this one file:
if OpenAI renames the methods, only `fetch_rate_limits` below has to change.

No credential is read, printed, or forwarded here -- the CLI is already
authenticated and the RPC never hands us a token.
"""

import argparse
import json
import os
import select
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import agentusage as au  # noqa: E402

AGENT_ID = "codex"
AGENT_NAME = "Codex"
RPC_TIMEOUT = 12.0

PLAN_LABELS = {
    "free": "Free",
    "plus": "Plus",
    "pro": "Pro",
    "business": "Business",
    "team": "Team",
    "enterprise": "Enterprise",
    "edu": "Edu",
}


def plan_label(raw: str) -> str:
    text = str(raw or "").strip()
    if not text:
        return ""
    return PLAN_LABELS.get(text.lower(), text.replace("_", " ").title())


class AppServer:
    """A short-lived `codex app-server` process spoken to over stdio."""

    def __init__(self, codex_path: str):
        self.proc = subprocess.Popen(
            # read-only sandbox + untrusted approvals: this process must never
            # be able to touch the filesystem or run anything on our behalf.
            [codex_path, "-s", "read-only", "-a", "untrusted", "app-server"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            # The CLI shells out to its own runtime, so it needs the same
            # augmented PATH we found it on, not the unit's minimal one.
            env=au.runtime_env(),
        )

    def request(self, request_id: int, method: str, params=None, timeout=8.0):
        self.proc.stdin.write(json.dumps({"id": request_id, "method": method, "params": params or {}}) + "\n")
        self.proc.stdin.flush()
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            ready, _, _ = select.select([self.proc.stdout], [], [], 0.2)
            if not ready:
                continue
            line = self.proc.stdout.readline()
            if not line:
                break
            try:
                message = json.loads(line)
            except ValueError:
                continue  # notifications and log lines share the stream
            if message.get("id") == request_id:
                if "error" in message:
                    raise RuntimeError(str(message["error"].get("message") or "RPC error"))
                return message.get("result") or {}
        raise TimeoutError(f"{method} timed out")

    def notify(self, method: str, params=None):
        self.proc.stdin.write(json.dumps({"method": method, "params": params or {}}) + "\n")
        self.proc.stdin.flush()

    def close(self):
        try:
            self.proc.terminate()
            self.proc.wait(timeout=2)
        except Exception:
            try:
                self.proc.kill()
            except Exception:
                pass


def window_limits(key_prefix: str, title: str, bucket: dict) -> list:
    """Turn one limit bucket's primary/secondary windows into limit entries."""
    out = []
    for slot in ("primary", "secondary"):
        window = bucket.get(slot)
        if not isinstance(window, dict):
            continue
        label = au.window_label(window.get("windowDurationMins"))
        if title:
            label = f"{title} · {label}"
        entry = au.limit(
            f"{key_prefix}.{slot}",
            label,
            window.get("usedPercent"),
            window.get("resetsAt"),
            group="primary" if not title else "scoped",
        )
        if entry:
            out.append(entry)
    return out


def credits_balance(bucket: dict):
    credits = bucket.get("credits")
    if not isinstance(credits, dict):
        return None
    if credits.get("unlimited"):
        return {"label": "Credits", "text": "Unlimited"}
    if not credits.get("hasCredits"):
        return None
    raw = str(credits.get("balance") or "0")
    try:
        return {"label": "Credits", "text": f"{float(raw):,.2f}"}
    except ValueError:
        return {"label": "Credits", "text": raw}


def fetch_rate_limits() -> dict:
    """The one function that knows Codex's undocumented RPC surface."""
    codex = au.which("codex")
    if not codex:
        return {
            "status": au.STATUS_NOT_CONFIGURED,
            "message": "The codex CLI was not found in PATH.",
        }

    server = None
    try:
        server = AppServer(codex)
        server.request(1, "initialize", {"clientInfo": {"name": "agent-usage", "version": "1"}}, timeout=RPC_TIMEOUT)
        server.notify("initialized")
        account = (server.request(2, "account/read", timeout=6.0).get("account")) or {}
        rate_result = server.request(3, "account/rateLimits/read", timeout=6.0)
        limits = rate_result.get("rateLimits") or {}
        by_id = rate_result.get("rateLimitsByLimitId")
    except Exception as exc:
        return {"status": au.STATUS_ERROR, "message": f"Could not read Codex usage: {exc}"}
    finally:
        if server:
            server.close()

    plan = plan_label(limits.get("planType") or account.get("planType") or account.get("type"))
    entries = window_limits("codex", "", limits)

    # `rateLimitsByLimitId` carries model-scoped allowances (a Spark-only
    # weekly window, say) that the flat primary/secondary pair never shows.
    # Only named buckets other than the account-wide one are worth adding.
    main_id = str(limits.get("limitId") or "")
    if isinstance(by_id, dict):
        for limit_id, bucket in sorted(by_id.items()):
            if not isinstance(bucket, dict) or limit_id == main_id:
                continue
            title = str(bucket.get("limitName") or limit_id).strip()
            entries.extend(window_limits(limit_id, title, bucket))

    if not entries:
        if account.get("requiresOpenaiAuth") and not account.get("email"):
            return {"status": au.STATUS_AUTH, "message": "Run `codex login` to authenticate.", "plan": plan}
        return {"status": au.STATUS_ERROR, "message": "Codex reported no rate limits.", "plan": plan}

    result = {"status": au.STATUS_OK, "plan": plan, "limits": entries}
    balance = credits_balance(limits)
    if balance:
        result["balance"] = balance
    if limits.get("spendControlReached"):
        result["message"] = "Spend control reached."
    return result


def main() -> int:
    parser = argparse.ArgumentParser(description="Print the Codex usage record as JSON.")
    parser.add_argument("--force", action="store_true", help="accepted for interface parity; this collector never caches")
    parser.parse_args()

    data = fetch_rate_limits()
    au.emit(
        au.record(
            AGENT_ID,
            AGENT_NAME,
            available=data.get("status") == au.STATUS_OK,
            status=data.get("status", au.STATUS_ERROR),
            plan=data.get("plan", ""),
            message=data.get("message", ""),
            limits=data.get("limits", []),
            balance=data.get("balance"),
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
