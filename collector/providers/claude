#!/usr/bin/python3
"""Print the Claude Code usage record as one JSON line.

Where the numbers come from
---------------------------
Claude Code stores its OAuth login in ~/.claude/.credentials.json (mode 0600).
The same access token authorizes GET https://api.anthropic.com/api/oauth/usage,
which returns the five-hour and seven-day windows the CLI shows in `/usage`.
Omarchy 4 uses the same endpoint (bin/omarchy-agent-usage-claude).

The endpoint is not part of Anthropic's documented public API, so it is fenced
into `probe_usage` below.

Security
--------
* Only `accessToken` is read. The refresh token is never touched, so this
  collector can never mint or rotate a credential.
* The token goes to exactly one place: the Authorization header of the request
  to api.anthropic.com. It is never logged, cached, or written to the record.
* We do not refresh an expired token -- running Claude Code does that. An
  expired login is reported as a status, not worked around.
"""

import argparse
import datetime as dt
import json
import re
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import agentusage as au  # noqa: E402

AGENT_ID = "claude"
AGENT_NAME = "Claude Code"
USAGE_ENDPOINT = "https://api.anthropic.com/api/oauth/usage"
# Anthropic rate-limits the usage endpoint itself. Reuse a recent answer
# unless the user explicitly asked for fresh numbers.
PROBE_MIN_INTERVAL = 120.0


def claude_dir() -> Path:
    import os

    configured = str(os.environ.get("CLAUDE_CONFIG_DIR") or "").strip()
    return Path(configured).expanduser() if configured else Path.home() / ".claude"


def plan_label(tier: str, subscription: str) -> str:
    match = re.search(r"max[_-]?(\d+x)", str(tier or ""), re.IGNORECASE)
    if match:
        return "Max " + match.group(1).lower()
    for name in (tier, subscription):
        text = str(name or "").strip()
        if text:
            return text.replace("default_claude_", "").replace("_", " ").title()
    return ""


def oauth_login():
    """(access_token, expires_at_ms, plan_label) from the CLI's own store."""
    data = au.read_json(claude_dir() / ".credentials.json")
    login = (data or {}).get("claudeAiOauth")
    if not isinstance(login, dict):
        return "", 0, ""
    try:
        expires = int(login.get("expiresAt") or 0)
    except (TypeError, ValueError):
        expires = 0
    plan = plan_label(login.get("rateLimitTier"), login.get("subscriptionType"))
    return str(login.get("accessToken") or ""), expires, plan


def scoped_window(kind: str) -> str:
    text = str(kind or "").lower()
    if "month" in text:
        return "Monthly limit"
    if "week" in text or "7_day" in text or "day" in text:
        return "Weekly limit"
    if "hour" in text or "session" in text:
        return "Session limit"
    return ""


def scale_is_percent(payload: dict) -> bool:
    """One payload speaks one convention; settle it once for every field."""
    samples = []
    for key in ("five_hour", "seven_day", "seven_day_oauth_apps"):
        bucket = payload.get(key)
        if isinstance(bucket, dict):
            samples.append(bucket.get("utilization"))
    entries = payload.get("limits")
    if isinstance(entries, list):
        samples += [e.get("percent") for e in entries if isinstance(e, dict)]
    for sample in samples:
        try:
            if float(sample) > 1:
                return True
        except (TypeError, ValueError):
            continue
    return False


def as_percent(value, is_percent_scale: bool):
    if value is None:
        return None
    try:
        number = float(value)
    except (TypeError, ValueError):
        return None
    return number if is_percent_scale else number * 100.0


def spend_balance(payload: dict):
    """Extra-usage credits, when the account has them enabled."""
    spend = payload.get("spend")
    if not isinstance(spend, dict) or not spend.get("enabled"):
        return None
    balance = spend.get("balance")
    if isinstance(balance, dict):
        amount = balance.get("amount_minor")
        exponent = balance.get("exponent")
        currency = str(balance.get("currency") or "")
        try:
            value = float(amount) / (10 ** int(exponent or 0))
            return {"label": "Credits", "text": f"{value:,.2f} {currency}".strip()}
        except (TypeError, ValueError):
            return None
    used = spend.get("used")
    if isinstance(used, dict) and spend.get("percent") is not None:
        return {"label": "Extra usage", "text": f"{float(spend['percent']):.0f}% of cap"}
    return None


def probe_usage(access_token: str) -> dict:
    """The one function that knows Anthropic's OAuth usage endpoint."""
    request = urllib.request.Request(
        USAGE_ENDPOINT,
        headers={
            "Authorization": "Bearer " + access_token,
            "anthropic-beta": "oauth-2025-04-20",
            "Accept": "application/json",
            "User-Agent": "agent-usage/1",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=12) as response:
            payload = json.loads(response.read().decode("utf-8", errors="replace"))
    except urllib.error.HTTPError as error:
        retry = (error.headers or {}).get("retry-after", "")
        if error.code == 429:
            note = f" Retry after {retry}s." if retry else ""
            return {"ok": False, "status": au.STATUS_ERROR, "message": "Anthropic is rate limiting usage checks." + note}
        if error.code in (401, 403):
            return {"ok": False, "status": au.STATUS_AUTH, "message": "Claude Code's sign-in was rejected. Start Claude Code to refresh it."}
        return {"ok": False, "status": au.STATUS_ERROR, "message": f"Usage endpoint returned status {error.code}."}
    except Exception:
        # No server was reached at all -- no route, no DNS. Worth retrying
        # sooner than a real error status would be.
        return {"ok": False, "status": au.STATUS_ERROR, "retry": True, "message": "Couldn't reach Anthropic. Check your connection."}

    is_percent = scale_is_percent(payload)
    limits = []

    session = payload.get("five_hour")
    if isinstance(session, dict):
        limits.append(au.limit("session", "5-hour limit", as_percent(session.get("utilization"), is_percent), session.get("resets_at")))

    weekly = payload.get("seven_day_oauth_apps") or payload.get("seven_day")
    if isinstance(weekly, dict):
        limits.append(au.limit("weekly", "Weekly limit", as_percent(weekly.get("utilization"), is_percent), weekly.get("resets_at")))

    # Model-scoped allowances only ever appear in the `limits` array -- the
    # matching flat keys (seven_day_opus, ...) stay null even when the account
    # is actively spending against them.
    entries = payload.get("limits")
    seen = set()
    if isinstance(entries, list):
        for entry in entries:
            if not isinstance(entry, dict):
                continue
            scope = entry.get("scope")
            model = scope.get("model") if isinstance(scope, dict) else None
            if not isinstance(model, dict):
                continue
            name = str(model.get("display_name") or model.get("id") or "").strip()
            kind = str(entry.get("kind") or "").strip()
            if not name or (name, kind) in seen:
                continue
            seen.add((name, kind))
            window = scoped_window(kind)
            label = f"{name} · {window}" if window else name
            limits.append(au.limit(f"scoped.{name}.{kind}", label, as_percent(entry.get("percent"), is_percent), entry.get("resets_at"), group="scoped"))

    limits = [entry for entry in limits if entry]
    if not limits:
        return {"ok": False, "status": au.STATUS_ERROR, "message": "Anthropic returned no usage limits."}
    return {"ok": True, "limits": limits, "balance": spend_balance(payload)}


def window_still_open(entry: dict, now: dt.datetime) -> bool:
    """A cached percentage describes a window; once it rolls over it lies."""
    raw = entry.get("resetsAt")
    if not raw:
        return True
    try:
        resets = dt.datetime.fromisoformat(str(raw).replace("Z", "+00:00"))
    except ValueError:
        return True
    if resets.tzinfo is None:
        resets = resets.replace(tzinfo=dt.timezone.utc)
    return resets > now


def collect(force: bool) -> dict:
    access_token, expires_at_ms, plan = oauth_login()

    probe_cache = au.cache_dir() / "claude-usage.json"
    cached = au.read_json(probe_cache) or {}
    now = dt.datetime.now(dt.timezone.utc)
    fallback = [e for e in (cached.get("limits") or []) if isinstance(e, dict) and window_still_open(e, now)]

    if not access_token:
        if not claude_dir().exists():
            return {"status": au.STATUS_NOT_CONFIGURED, "message": "Claude Code is not signed in. Run `claude` to log in."}
        return {"status": au.STATUS_AUTH, "message": "No saved Claude Code sign-in found. Run `claude` to log in.", "limits": fallback, "plan": plan}

    if expires_at_ms and expires_at_ms <= time.time() * 1000:
        note = " Showing the last known limits." if fallback else ""
        return {
            "status": au.STATUS_AUTH,
            "message": "Claude Code's saved sign-in expired." + note + " Start Claude Code to refresh it.",
            "limits": fallback,
            "plan": plan,
            "stale": bool(fallback),
        }

    fetched_at = float(cached.get("fetchedAt") or 0)
    if fallback and not force and time.time() - fetched_at < PROBE_MIN_INTERVAL:
        return {"status": au.STATUS_OK, "limits": fallback, "plan": plan, "balance": cached.get("balance")}

    probe = probe_usage(access_token)
    if probe["ok"]:
        au.write_json_atomic(probe_cache, {"fetchedAt": time.time(), "limits": probe["limits"], "balance": probe.get("balance")})
        return {"status": au.STATUS_OK, "limits": probe["limits"], "plan": plan, "balance": probe.get("balance")}

    if fallback:
        return {"status": au.STATUS_OK, "limits": fallback, "plan": plan, "balance": cached.get("balance"), "stale": True, "message": probe["message"]}
    return {"status": probe["status"], "message": probe["message"], "plan": plan}


def main() -> int:
    parser = argparse.ArgumentParser(description="Print the Claude Code usage record as JSON.")
    parser.add_argument("--force", action="store_true", help="re-probe even if a recent answer is cached")
    args = parser.parse_args()

    data = collect(args.force)
    au.emit(
        au.record(
            AGENT_ID,
            AGENT_NAME,
            available=data.get("status") == au.STATUS_OK,
            status=data.get("status", au.STATUS_ERROR),
            plan=data.get("plan", ""),
            message=data.get("message", ""),
            limits=data.get("limits", []),
            balance=data.get("balance"),
            stale=bool(data.get("stale")),
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
